# Conexão com a branch dev do Neon. Nunca use a branch principal aqui.
DATABASE_URL=
# Gere um valor aleatório longo. Nunca versione.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Pode ficar "true" aqui, porque este arquivo aponta para a branch dev.
# Em produção, só durante a criação da sua conta.
ALLOW_SIGNUP=false
# Endereço de rede do computador, para abrir o app no celular.
BETTER_AUTH_TRUSTED_ORIGINS=
# Envio do e-mail de redefinir senha, pelo Gmail com senha de app.
# Opcional aqui: sem elas, o link aparece no terminal do npm run dev.
GMAIL_USER=
GMAIL_APP_PASSWORD=
