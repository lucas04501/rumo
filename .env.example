# Conexão com a branch dev do Neon. Nunca use a branch principal aqui.
DATABASE_URL=
# Gere um valor aleatório longo. Nunca versione.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Pode ficar "true" aqui, porque este arquivo aponta para a branch dev.
# Em produção, só durante a criação da sua conta.
ALLOW_SIGNUP=false
# Endereço de rede do computador, para abrir o app no celular.
BETTER_AUTH_TRUSTED_ORIGINS=
# Envio do e-mail de redefinir senha, pelo Gmail com senha de app.
# Opcional aqui: sem elas, o link aparece no terminal do npm run dev.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Exige confirmar o e-mail para entrar. Desligado por padrão; só funciona com o envio de e-mail configurado.
REQUIRE_EMAIL_VERIFICATION=false
# Mostra a seção de planos e preços na landing. Não é segredo: vai para o cliente no build.
# Ligue junto com BILLING_ENABLED, nunca antes: sem cobrança, a landing não mostra preço.
VITE_SHOW_PRICING=false
