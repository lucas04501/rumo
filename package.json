{
  "name": "rumo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"vite\" \"tsx watch --env-file=.env server/dev.ts\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/query-async-storage-persister": "^5.105.1",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-query-persist-client": "^5.105.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
